{
  pkgs,
  pkgs-unstable,
  lib,
  ...
}:

let
  inherit (pkgs-unstable) hyprland;
  ghostty = lib.getExe pkgs-unstable.ghostty; # same package as programs/ghostty.nix
  noctalia = "noctalia msg";
  lenovo = "desc:Lenovo Group Limited N27q UT33383Y";

  # Same app-to-number mapping as programs/umbriel.nix and programs/mango.nix.
  # Each is a persistent named workspace bound to its monitor. Unlike umbriel,
  # Hyprland creates a bound workspace on the current monitor when its own is
  # missing, and moves it back when that monitor connects
  # (CMonitor::onConnect), so Mod+N works docked or not.
  workspaces = [
    {
      name = "terminal";
      monitor = lenovo;
      # Placed by PID, so this has to stay its own process: as a single
      # instance it can hand its window to another ghostty process (or exit
      # quietly), and the login terminal never reached its workspace.
      # systemd-cat execs in place (same PID) and puts its output in the
      # journal: journalctl --user -t ghostty-login.
      cmd = "systemd-cat -t ghostty-login ${ghostty} --gtk-single-instance=false";
    }
    {
      name = "browser";
      monitor = lenovo;
      cmd = "firefox";
    }
    {
      name = "chat";
      monitor = "eDP-1";
      cmd = "vesktop";
    }
    {
      name = "telegram";
      monitor = "eDP-1";
      cmd = "Telegram";
    }
  ];
  numbered = lib.imap1 (i: w: w // { key = toString i; }) workspaces;

  lua = builtins.toJSON; # JSON strings are valid Lua string literals
  exec = cmd: "hl.dsp.exec_cmd(${lua cmd})";
  bind =
    keys: dsp: opts:
    "hl.bind(${lua keys}, ${dsp}${lib.optionalString (opts != "") ", ${opts}"})";

  config = ''
    -- Generated by programs/hyprland.nix.

    hl.monitor({ output = ${lua lenovo}, mode = "2560x1440@99.946", position = "0x0", scale = 1 })
    hl.monitor({ output = "eDP-1", mode = "preferred", position = "0x1440", scale = 1 })
    hl.monitor({ output = "DP-2", mode = "1920x1080@239.757", position = "auto", scale = 1, vrr = 1 })
    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

    hl.config({
      general = {
        layout = "dwindle",
        gaps_in = 4,
        gaps_out = 8,
        border_size = 2,
      },
      decoration = {
        rounding = 20,
        blur = { enabled = true, xray = false },
      },
      dwindle = { preserve_split = true },
      input = {
        kb_layout = "us,ru",
        kb_options = "grp:alt_shift_toggle",
        repeat_rate = 50,
        repeat_delay = 300,
        follow_mouse = 1,
        accel_profile = "flat",
        touchpad = {
          natural_scroll = true,
          tap_to_click = true,
          disable_while_typing = true,
        },
      },
      cursor = { warp_on_change_workspace = 1 },
      misc = {
        -- Notification actions and window activation from noctalia.
        focus_on_activate = true,
        -- noctalia draws the wallpaper.
        force_default_wallpaper = 0,
        disable_hyprland_logo = true,
      },
      ecosystem = { no_update_news = true, no_donation_nag = true },
    })

    hl.gesture({ fingers = 3, direction = "horizontal", action = "workspace" })

    -- Workspaces --------------------------------------------------------------
    ${lib.concatMapStringsSep "\n" (
      w:
      "hl.workspace_rule({ workspace = ${lua "name:${w.name}"}, monitor = ${lua w.monitor}, persistent = true })"
    ) workspaces}

    -- Each app on its workspace, but only the instance started here, so a
    -- terminal opened later with Mod+Return lands on the focused workspace.
    -- noctalia starts from its systemd service, so it isn't here.
    hl.on("hyprland.start", function()
    ${lib.concatMapStringsSep "\n" (
      w: "  hl.exec_cmd(${lua w.cmd}, { workspace = ${lua "name:${w.name} silent"} })"
    ) workspaces}
    end)

    -- Binds -------------------------------------------------------------------
    ${lib.concatStringsSep "\n" [
      (bind "SUPER + Return" (exec ghostty) "")
      (bind "SUPER + SHIFT + Q" "hl.dsp.window.close()" "")
      (bind "SUPER + Escape" (exec "${noctalia} session lock") "")
      (bind "SUPER + SHIFT + E" "hl.dsp.exit()" "")
      (bind "SUPER + CTRL + R" "hl.dsp.reload_config()" "")

      (bind "SUPER + D" (exec "${noctalia} panel-toggle launcher") "")
      (bind "SUPER + S" (exec "${noctalia} panel-toggle control-center") "")
      (bind "SUPER + comma" (exec "${noctalia} settings-toggle") "")
      (bind "SUPER + SHIFT + S" (exec "${noctalia} screenshot-region") "")
      # Start/stop noctalia's screen_recorder plugin (programs/noctalia.nix).
      (bind "SUPER + SHIFT + R" (exec "${noctalia} plugin noctalia/screen_recorder:service all toggle")
        ""
      )

      (bind "XF86AudioRaiseVolume" (exec "${noctalia} volume-up") "{ locked = true, repeating = true }")
      (bind "XF86AudioLowerVolume" (exec "${noctalia} volume-down") "{ locked = true, repeating = true }")
      (bind "XF86AudioMute" (exec "${noctalia} volume-mute") "{ locked = true }")
      (bind "XF86MonBrightnessUp" (exec "${noctalia} brightness-up")
        "{ locked = true, repeating = true }"
      )
      (bind "XF86MonBrightnessDown" (exec "${noctalia} brightness-down")
        "{ locked = true, repeating = true }"
      )

      (bind "SUPER + F" "hl.dsp.window.fullscreen()" "")
      (bind "SUPER + space" ''hl.dsp.window.float({ action = "toggle" })'' "")
      (bind "SUPER + R" ''hl.dsp.layout("togglesplit")'' "")
      (bind "SUPER + minus" ''hl.dsp.layout("splitratio -0.1")'' "{ repeating = true }")
      (bind "SUPER + equal" ''hl.dsp.layout("splitratio 0.1")'' "{ repeating = true }")

      (bind "SUPER + mouse:272" "hl.dsp.window.drag()" "{ mouse = true }")
      (bind "SUPER + mouse:273" "hl.dsp.window.resize()" "{ mouse = true }")
      # m±1: this monitor's workspaces, persistent empty ones included.
      (bind "SUPER + mouse_up" ''hl.dsp.focus({ workspace = "m-1" })'' "")
      (bind "SUPER + mouse_down" ''hl.dsp.focus({ workspace = "m+1" })'' "")
      (bind "SUPER + SHIFT + mouse_up" ''hl.dsp.window.move({ workspace = "m-1" })'' "")
      (bind "SUPER + SHIFT + mouse_down" ''hl.dsp.window.move({ workspace = "m+1" })'' "")
    ]}
    for _, d in ipairs({ "left", "right", "up", "down" }) do
      hl.bind("SUPER + " .. d, hl.dsp.focus({ direction = d }))
      hl.bind("SUPER + SHIFT + " .. d, hl.dsp.window.swap({ direction = d }))
    end
    ${lib.concatMapStringsSep "\n" (w: ''
      ${bind "SUPER + ${w.key}" "hl.dsp.focus({ workspace = ${lua "name:${w.name}"} })" ""}
      ${bind "SUPER + SHIFT + ${w.key}" "hl.dsp.window.move({ workspace = ${lua "name:${w.name}"} })"
        ""
      }'') numbered}

    -- Rules -------------------------------------------------------------------
    hl.window_rule({
      name = "noctalia-settings",
      match = { class = "^dev\\.noctalia\\.Noctalia\\.Settings$" },
      float = true,
      size = "1080 920",
    })

    -- Noctalia's translucent bar, panels and notifications: blur what's behind.
    hl.layer_rule({
      name = "noctalia-blur",
      match = { namespace = "^noctalia-(bar-.+|notification|dock|panel|attached-panel|osd)$" },
      blur = true,
      blur_popups = true,
      ignore_alpha = 0.5,
    })
  '';

  # noctalia's hyprland template renders ~/.config/hypr/noctalia.lua at
  # runtime and appends a require of it unless one is present; this file is a
  # read-only link, so the require is here. pcall: the file doesn't exist
  # until noctalia first applies its theme.
  theme = ''

    -- For Noctalia Color templates
    pcall(function() require("noctalia").apply_theme() end)
  '';
in
{
  # The compositor, session and portal come from the NixOS module
  # (hosts/common/desktop.nix); this only writes ~/.config/hypr/hyprland.lua.
  wayland.windowManager.hyprland = {
    enable = true;
    package = null;
    portalPackage = null;
    configType = "lua";
    extraConfig = config + theme;
  };

  # `Hyprland --verify-config` on everything but the runtime theme require, so
  # a typo fails the build instead of a login. The marker only pulls the check
  # into the generation, like umbriel's.
  xdg.configFile."hypr/.validated".source =
    pkgs.runCommand "hyprland-config-validated" { nativeBuildInputs = [ hyprland ]; }
      ''
        export HOME=$TMPDIR XDG_RUNTIME_DIR=$TMPDIR
        cp ${pkgs.writeText "hyprland.lua" config} $TMPDIR/hyprland.lua
        Hyprland --verify-config -c $TMPDIR/hyprland.lua 2>&1 | tee $TMPDIR/log
        # Exits 0 even when it can't bind its IPC socket (logged as ERR), so
        # judge by the parse result line.
        grep -qx 'config ok' $TMPDIR/log
        touch $out
      '';
}
